use v6.d;
use Test;

use Math::Splines;

my @linear = b-spline-curve-value([[0, 0], [10, 0]], degree => 1, argument => 0.25);
is-approx @linear[0], 2.5, 'default knots use the degree/control-point argument order';
is-approx @linear[1], 0, 'linear curve retains its y coordinate';

my @endpoint = b-spline-curve-value([[0, 0], [10, 0]], degree => 1, argument => 1);
is-approx @endpoint[0], 10, 'rational de Boor evaluation includes the right endpoint';
is-approx @endpoint[1], 0, 'right endpoint retains its y coordinate';

my @weighted = b-spline-curve-value([[0, 0], [10, 0]], weights => [1, 2], degree => 1, argument => 0.5);
is-approx @weighted[0], 20/3, 'rational de Boor evaluation applies weights';
is-approx @weighted[1], 0, 'weighted curve retains its y coordinate';

done-testing;
